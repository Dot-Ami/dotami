{
  "name": "civic-trace-prototype",
  "version": "0.0.1",
  "private": true,
  "description": "Local prototype of a public-interest investigation and civic-action platform. Synthetic demo data only.",
  "scripts": {
    "dev": "node scripts/next.mjs dev -H 127.0.0.1 -p 3200",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start -H 127.0.0.1 -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

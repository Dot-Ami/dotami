DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
ANTHROPIC_API_KEY=""
# Optional. The only in-app model call is the intake's free-text parser; with the key empty
# its deterministic keyword fallback answers instead (see lib/journey/intent-fallback.ts).
# Node states, unlocks and risk reads never come from a model either way.
#INTENT_ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
#STUB_USER_EMAIL="stub@dotami.local"

# Optional: a local statute store implementing the lookup contract (see docs/architecture/law-store.md).
# When set, /api/law/provision can show a provision's own words next to its citation.
# Unset = every citation stays a plain link to the official text. Leave unset unless you run one.
LAW_STORE_PATH=

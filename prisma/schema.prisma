generator client {
  provider = "prisma-client-js"
}

// SQLite since 2026-09-28: the whole database is one file on the person's machine, which a
// desktop app can ship without a database server (docs/architecture/use-cases.md § The desktop
// app). SQLite has no list columns, so the four list fields below are JSON arrays; the
// read side turns them back into string[] in lib/db/json-list.ts.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VentureType {
  SERVICE
  PRODUCT
  SIDE_GIG
}

/// Where an idea is. The app, the catalogs and every reply use these names (AB, BC, ...); the data file
/// stores each as its international code from ISO 3166-2:CA ("CA-AB"), the maintainer's decision of
/// 2026-10-11 (docs/architecture/future-cockpit.md § 7). Migration 20261012000000_place_codes moved the
/// values already in the file. A new value is added with its own @map, never without one.
enum Province {
  AB @map("CA-AB")
  BC @map("CA-BC")
  MB @map("CA-MB")
  NB @map("CA-NB")
  NL @map("CA-NL")
  NS @map("CA-NS")
  NT @map("CA-NT")
  NU @map("CA-NU")
  ON @map("CA-ON")
  PE @map("CA-PE")
  QC @map("CA-QC")
  SK @map("CA-SK")
  YT @map("CA-YT")
}

/// S2.5.4i: where an idea is on its way to being a business. the ideas DB: every idea is a
/// Venture row from the moment it is named; `stage` says how real it is.
enum VentureStage {
  IDEA
  PROTOTYPE
  FIRST_CUSTOMERS
  ESTABLISHED
}

/// S2.5.4i: how two of the person's ideas relate. Undirected in meaning; stored once (from -> to).
/// maintainer ruling, 2026-09-14: \"some of them will likely intertwine, overlap, and can eventually become
/// sister companies ... they will know what I am working on and be able to cross reference each idea."
enum VentureLinkKind {
  SISTER
  OVERLAPS
  FEEDS
  RELATED
}

enum EmploymentStatus {
  EMPLOYEE
  APPRENTICE
  SELF_EMPLOYED
  BUSINESS_OWNER
  RETIRED
  UNEMPLOYED
  OTHER
  /// Not asked: a future picked on *Pick a future* is saved before anyone asks the person's work
  /// situation (2026-10-12; docs/architecture/future-cockpit.md § 1, The way in as built). The rules read
  /// it as unanswered. SQLite keeps an enum as text, so adding a value changes no table.
  NOT_SAID
}

model User {
  id               String            @id @default(cuid())
  email            String?           @unique
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ventures         Venture[]
  personStatements PersonStatement[]
  skillMarks       SkillMark[]
  personFigures    PersonFigure[]
}

/// What the person told DotAmi about themselves — verbatim, dated, append-only (S2.5.4a).
/// Charter rule: never summarised into a profile; a newer row supersedes by `saidAt`, never by
/// editing an older one. No UPDATE path exists on purpose, and no way to delete one statement. The
/// one DELETE is all of them at once, from the Delete menu on /your-data (lib/privacy/delete.ts; the
/// maintainer's decision, 2026-10-07): wiping every statement isn't editing history. Every statement DotAmi holds is a
/// row here: nothing is read from anywhere else (the `vault` field in the statements API's response
/// is a reserved slot that says no outside source is configured).
model PersonStatement {
  id        String   @id @default(cuid())
  userId    String
  /// The person's own words. Max length enforced at the API (STATEMENT_MAX_CHARS).
  text      String
  /// The calendar day the person says they said it — their claim, not the insert time. Stored
  /// as midnight UTC of that day (lib/person/statements.ts writes it that way).
  saidAt    DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The idea this was typed for: the sentence typed on the front door, kept with the idea the intake
  /// first saved (2026-10-11). Null for statements about the person, and once the idea is deleted: the
  /// statement stays, tied to no idea (lib/privacy/inventory.ts, the ideas box's `keeps`).
  ventureId String?
  venture   Venture? @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  /// What the statement answers, when it answers a question: "destination" for the answer to "where do
  /// you want to be" (the cockpit's top line; docs/architecture/future-cockpit.md § 7, Storage as built).
  /// Null for everything else. A change is a new statement; the newest destination is the current one.
  kind      String?

  @@index([userId, saidAt])
}

model Venture {
  id               String           @id @default(cuid())
  userId           String
  /// Stable key from TS scenarios (e.g. `example-service`); the cockpit's scenario id.
  scenarioSeedKey  String?          @unique
  name             String
  type             VentureType
  province         Province
  targetRevenueY1  Int
  targetRevenueY3  Int
  structure        String           @default("sole-prop")
  /// S2.5.4d: "user" = the person set the structure; "assumed" = the map's default (sole-prop).
  structureSource  String           @default("assumed")
  hireFirst        Boolean          @default(false)
  /// S2.5.4e: intake Screen A tags + capital toggle, so the cockpit evaluator sees what the person said.
  /// A JSON array of strings.
  activityTags     Json             @default("[]")
  capitalPurchasePlanned Boolean    @default(false)
  employmentStatus EmploymentStatus
  /// S2.5.4i: idea -> prototype -> first customers -> established. Intake's `ventureStage` lands here.
  stage            VentureStage     @default(IDEA)
  /// S2.5.4i: the person's own notes on the idea, in their words. Free text; never summarised by the app.
  notes            String           @default("")
  /// The goal chips picked on the intake (lib/journey/types.ts INTAKE_GOAL_IDS), written once, when the
  /// intake first saves the idea (2026-10-11); shown back on its card and read by no rule. A JSON array
  /// of strings.
  goals            Json             @default("[]")
  /// The road this future is drawn on (lib/engines/roads/v2026 `roadsV2026`, a permanent id); null =
  /// today's general road, so every idea saved before roads existed keeps its map (2026-10-11).
  roadId           String?
  /// The moment the person chose that road; null while the idea is on the general road (2026-10-12).
  roadChosenAt     DateTime?
  /// The ending picked at each fork of that road, `{ "<fork id>": { "stepId": "<step id>", "pickedAt": "<ISO>" } }`.
  /// Road 0's two forks are NOT here: they stay in ScenarioState.activeBranches, which the map rewrites on
  /// every save. A JSON object.
  forkPicks        Json             @default("{}")
  /// The person's own date, a month and year ("2029-05"); null until they set one. Never set by DotAmi.
  targetMonth      String?
  /// The moment the person set that month; null while there is none (2026-10-12).
  targetMonthSetAt DateTime?
  /// The answer to "a business of your own, a job or career, or both?" on *Your destination*
  /// (lib/front-door/questions.ts LOOKING_FOR: "business", "career", "both-or-not-sure"), written once,
  /// when *Pick a future* saves the idea; null for every idea saved another way (2026-10-12).
  lookingFor       String?
  /// The moment that answer was kept with the idea; null with it.
  lookingForSetAt  DateTime?
  /// The idea's answers it was saved without, because nobody was asked (a future picked on *Pick a
  /// future*, 2026-10-12): a JSON list of lib/scenarios/types.ts NOT_SAID_FIELDS ("venture-type",
  /// "equipment", "sales-target-year-1", "sales-target-year-3"; until 2026-10-21 one "sales-targets",
  /// still read as both). Their columns keep the intake's starting values; this list stops
  /// anything saying the person told DotAmi them. [] for every other idea; a save with no list clears it.
  notSaid          Json             @default("[]")
  /// The job the person picked as closest to the work they'd do themselves, an OaSIS profile code ("72311.00"),
  /// so the cockpit shows the government's skills list for it, tagged "your pick of job"; null until they
  /// pick one. Never set by DotAmi (2026-10-12; lib/futures/job.ts).
  occupationCode   String?
  /// The moment the person picked that job; null while there is none.
  occupationPickedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioState    ScenarioState?
  linksFrom        VentureLink[]    @relation("VentureLinkFrom")
  linksTo          VentureLink[]    @relation("VentureLinkTo")
  figures          Figure[]
  expenses         Expense[]
  /// Statements typed for this idea (its first sentence); they outlive it, tied to no idea.
  statements       PersonStatement[]
  /// The person's progress on each step of this future's road; deleted with the future.
  stepProgress     StepProgress[]
  /// The businesses the person is watching for this idea (2026-10-17); deleted with the idea.
  watchedBusinesses WatchedBusiness[]

  @@index([userId])
}

/// S2.5.4i: a cross-reference between two ideas. `note` is the person's reason, in their words.
model VentureLink {
  id        String          @id @default(cuid())
  fromId    String
  toId      String
  kind      VentureLinkKind @default(RELATED)
  note      String          @default("")
  createdAt DateTime        @default(now())
  from      Venture         @relation("VentureLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Venture         @relation("VentureLinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
}

model ScenarioState {
  id              String   @id @default(cuid())
  ventureId       String   @unique
  /// JSON arrays of lifecycle node ids.
  activeNodeIds   Json
  completedNodeIds Json
  ghostedNodeIds  Json
  activeBranches  Json
  updatedAt       DateTime @updatedAt
  venture         Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
}

/// [8a] A total about the person's business — confirmed only by the person agreeing to it in the
/// agree prompt ([8b]). Totals, never transactions; the file it came from is never kept.
model Figure {
  id             String    @id @default(cuid())
  ventureId      String
  /// lib/figures/types.ts FIGURE_KINDS — "gross-revenue" and the four T2125 totals ([8f]).
  kind           String
  /// First and last calendar day the total covers, inclusive; stored as midnight UTC of that day.
  periodStart    DateTime
  periodEnd      DateTime
  /// Integer cents, never floating point; negative allowed (a loss). BigInt: Int tops out at $21M.
  amountCents    BigInt
  /// ISO 4217, stored as given — never converted.
  currency       String    @default("CAD")
  /// "typed" | "file" | "agent" | "tax-return" | "books"
  sourceKind     String
  /// What the person sees as the source, e.g. "typed by you", "sales-2025.xlsx", "the Lens".
  sourceLabel    String
  /// How many rows were summed, when it came from a file.
  sourceRows     Int?
  /// [8f] The tax year a T2125 total is for; null for every other kind.
  taxYear        Int?
  /// [8f] The form and line as printed on the return it was read from, e.g. "T2125 8299"; null unless the source is a tax return.
  formLine       String?
  /// The road, step and named cost line a "start-up-cost-line" figure prices (permanent catalog ids);
  /// null on every other kind (2026-10-11).
  roadId         String?
  roadStepId     String?
  costLineId     String?
  /// Where a cost line's amount came from: "quote" | "link" | "receipt" | "your-guess"
  /// (lib/figures/types.ts COST_LINE_AMOUNT_FROM); null on every other kind.
  amountFrom     String?
  /// "proposed" | "confirmed" | "retracted" | "discarded"
  status         String    @default("proposed")
  editedByPerson Boolean   @default(false)
  proposedAt     DateTime  @default(now())
  confirmedAt    DateTime?
  retractedAt    DateTime?
  venture        Venture   @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId, status])
}

/// [8i] One business expense — a single record, not a total: waiting for the person's click, agreed,
/// turned down or taken back, like a Figure's states. Typed by the
/// person now; a spreadsheet, a bank statement or the Lens may propose records later, and each waits
/// for the person's click in the agree prompt, exactly like a Figure. Holds no bank or card number.
/// A receipt file the person adds is described by its own Receipt row (below), never stored in this
/// table. docs/architecture/expense-records.md § 1;
/// docs/architecture/figures-privacy-review.md.
///
/// Since the maintainer's decisions (2026-10-08): the idea is optional (a record can wait "not
/// attached yet" and be attached later), a record may carry the person's own business share, and a
/// refund or credit is kept either as a negative amount or as a separate "refund" record linked to
/// the expense it came from. The migration that made this change rebuilds this table only
/// (prisma/migrations/20261008120000_expenses_typed/migration.sql), never Venture.
/// Deleting an idea keeps its records: their idea is cleared and they wait "not attached yet" (the
/// maintainer's decision of 2026-10-08), so nothing the person typed is lost with an idea.
model Expense {
  id              String    @id @default(cuid())
  /// The idea it is attached to, or null while it is "not attached yet" (including after that idea is deleted).
  ventureId       String?
  /// The calendar day of the purchase; stored as midnight UTC of that day, like a Figure's period dates.
  date            DateTime
  /// Whole cents, never floating point. BigInt like Figure.amountCents.
  amountCents     BigInt
  /// ISO 4217, stored as given — never converted.
  currency        String    @default("CAD")
  /// Who it was paid to, in the person's own words ("Staples").
  paidTo          String
  /// What it was for, in the person's own words ("printer paper").
  whatFor         String
  /// Only what the person picked or agreed to; DotAmi never fills one in from the seller's name.
  category        String?
  /// Optional, typed by the person (the CRA lists the seller's address for a record).
  sellerAddress   String?
  /// Optional, typed by the person; lib/expenses/validate.ts says what shape is accepted.
  vendorGstNumber String?
  /// "expense" | "refund" (lib/expenses/types.ts EXPENSE_RECORD_KINDS). A refund record holds the amount
  /// that came back and points at the expense it came from; a refund kept as a negative amount is an
  /// "expense" record with an amount below zero.
  recordKind      String    @default("expense")
  /// The expense a refund or credit came from, when there is one. Cleared, not deleted, if that
  /// expense is ever deleted, so the refund's own record survives.
  refundOfId      String?
  /// The GST/HST part of the amount, if the person gave it: whole cents, never negative, at most the amount.
  gstHstCents     BigInt?
  /// A refund's credit note, as the person typed it (its number, its date). Refunds only.
  creditNote      String?
  /// The person's own business share of a mixed-use purchase, a whole percent from 1 to 100, kept
  /// beside the full amount. DotAmi never sets it and never works out a "deductible" amount from it.
  businessSharePercent Int?
  /// "typed" | "file" | "agent" (lib/expenses/types.ts EXPENSE_SOURCE_KINDS)
  sourceKind      String
  /// What the person sees as the source, e.g. "typed by you", "the Lens".
  sourceLabel     String
  /// "proposed" | "confirmed" | "retracted" | "discarded"
  status          String    @default("proposed")
  editedByPerson  Boolean   @default(false)
  proposedAt      DateTime  @default(now())
  agreedAt        DateTime?
  retractedAt     DateTime?
  venture         Venture?  @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  refundOf        Expense?  @relation("ExpenseRefunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds         Expense[] @relation("ExpenseRefunds")
  receipt         Receipt?

  @@index([ventureId, status])
  @@index([refundOfId])
}

/// [8i] The receipt file the person added to one expense record. The file itself is NOT in the
/// database: it is a copy in the receipts/ folder beside the data file, named by DotAmi
/// "<id>.<ext>" (the random id below, and the extension of the type DotAmi read from the bytes),
/// never by the person's own file name, which is not kept. This row says which file belongs to
/// which record and what DotAmi checked when it was added. lib/expenses/receipts/ reads and writes
/// both; docs/architecture/expense-records.md § 7 is the design.
///
/// One receipt per record. Deleting the record deletes this row (onDelete: Cascade) and DotAmi's
/// sweep then removes the file; deleting an idea keeps the record, so its receipt stays too.
model Receipt {
  /// 32 lowercase hex characters from a random source; also the file's name in receipts/.
  id        String   @id
  expenseId String   @unique
  /// "image/jpeg" | "image/png" | "image/webp" | "application/pdf", decided from the file's first
  /// bytes (lib/expenses/receipts/sniff.ts), never from its name or the type the browser reported.
  type      String
  /// The file's size in bytes, at most 10 MB (the maintainer's cap, 2026-10-08).
  bytes     Int
  /// SHA-256 of the file's bytes, lowercase hex, so DotAmi can tell a file that changed on the disk.
  sha256    String
  addedAt   DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

/// [8e] The person's saved choices — DotAmi's first settings table. One row per setting: `key` is a
/// settings-catalog id (lib/settings/catalog.ts), `value` is that setting's JSON text. Which keys
/// exist and what their values may look like is decided in code (lib/settings/values.ts), not here,
/// so a later setting is a new key and never a new column or table.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// [8g] A bank or card account the person allowed DotAmi to read statements from, listed under the
/// person's own name for it ("Business chequing", "Visa ending 1234"; lib/figures/source-account-name.ts
/// says which names are accepted). Never an account or card number, a bank, branch or transit
/// number, a file name, or a hash of any of those: an account number has so few possible values
/// that a hash of it can be reversed by trying them all. Nothing links to this table yet — which
/// figure came from which account waits on a later decision — so taking an account back
/// (`retiredAt`) leaves the figures read from its statements alone. Any later link INTO this table
/// must be hand-written SQL with a test that seeded data survives (the desktop migrator runs with
/// foreign keys on).
model SourceAccount {
  id        String    @id @default(cuid())
  /// The person's own name for the account, as they typed it (trimmed).
  name      String
  /// "once" | "always" | "every" (ACCOUNT_ALLOWANCES in lib/figures/source-account-name.ts): which button
  /// the person pressed on the warning ("every": added while "Always allow every account" was on).
  /// "once" shows the warning again before the next statement.
  allowance String
  /// When the person last agreed to the warning for this account.
  agreedAt  DateTime
  /// When the person took it back in Settings; null while it is in use. The row stays (its name
  /// and dates) until Delete removes every account.
  retiredAt DateTime?
  createdAt DateTime  @default(now())
}

/// The person's own mark on one skill or requirement (2026-10-11; docs/architecture/future-cockpit.md
/// § 7, Storage as built). Per person, not per future, so a mark carries across every road listing the
/// item. Either `skillItemId` (a permanent id from the shared skill list, lib/engines/roads/v2026
/// `skillItemsV2026`) or `ownLabel` (a skill the person added, in their words), never both;
/// lib/futures/skill-marks.ts keeps that rule. "I don't know" is not stored: it removes the mark.
model SkillMark {
  id          String   @id @default(cuid())
  userId      String
  skillItemId String?
  /// A skill the person added themselves, as they typed it (trimmed).
  ownLabel    String?
  /// "have" | "learning" | "not-yet" (lib/futures/types.ts SKILL_MARKS)
  mark        String
  /// When the person last set this mark.
  markedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillItemId])
  @@unique([userId, ownLabel])
}

/// The person's progress on one step of a future's road (2026-10-11). Keyed by the road's and the
/// step's permanent ids, never a position or a title, so moving a step to another column or renaming it
/// never loses anyone's progress. Never used to rank anything. Deleted with its future.
model StepProgress {
  id          String   @id @default(cuid())
  ventureId   String
  roadId      String
  stepId      String
  /// "doing" | "done" | "not-for-me" (lib/futures/types.ts STEP_STATUSES), or null when none is set.
  status      String?
  /// The ids of the step's "done when" lines the person ticked. A JSON array of strings.
  doneWhenIds Json     @default("[]")
  /// Status changes, oldest first, each `{ "at": ISO moment, "status": … }`; the newest 100 are kept.
  changes     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@unique([ventureId, roadId, stepId])
}

/// A number the person gives about themselves rather than about one future (2026-10-11): today only the
/// yearly income they want, before tax. Agreed like a figure (proposed, then the person's click), but it
/// belongs to the person: a Figure needs a future and is deleted with it. lib/futures/person-figures.ts.
model PersonFigure {
  id             String    @id @default(cuid())
  userId         String
  /// lib/futures/types.ts PERSON_FIGURE_KINDS: "income-wanted".
  kind           String
  /// Whole cents, never negative. BigInt like Figure.amountCents.
  amountCents    BigInt
  /// ISO 4217, stored as given — never converted.
  currency       String    @default("CAD")
  /// What the amount is per: "year".
  per            String
  /// "typed"
  sourceKind     String
  sourceLabel    String
  /// "proposed" | "confirmed" | "retracted" | "discarded", as a Figure's.
  status         String    @default("proposed")
  editedByPerson Boolean   @default(false)
  proposedAt     DateTime  @default(now())
  confirmedAt    DateTime?
  retractedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, status])
}

/// A business the person is watching for one idea (2026-10-17; "Businesses you're watching" in the
/// cockpit's "Others in this line of work", docs/architecture/competitive-landscape.md § 6.2 item 5). Only
/// what the person typed: the name as they wrote it, a link, their note, and the ads they saw, each with the
/// day they saw it. DotAmi checks none of it, no rule reads it, and nothing leaves the computer. Links are
/// http: or https: only (lib/landscape/links.ts). Deleted with its idea. lib/landscape/watched.ts.
model WatchedBusiness {
  id          String   @id @default(cuid())
  ventureId   String
  /// The name as the person typed it (trimmed at the ends only).
  nameAsTyped String
  /// An http: or https: address the person gave, or null.
  url         String?
  /// The person's own note, word for word, or null.
  note        String?
  /// The ads the person saw, oldest given first: `[{ "url": "https://…", "seenOn": "YYYY-MM-DD" }]`, the day
  /// as the person set it. A JSON array, read back through lib/landscape/watched.ts.
  adLinks     Json     @default("[]")
  /// The moment the person added it; the list is shown in this order.
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId])
}

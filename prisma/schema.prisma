generator client {
  provider = "prisma-client-js"
}

// SQLite since 2026-09-28: the whole database is one file on the person's machine, which a
// desktop app can ship without a database server (docs/architecture/use-cases.md § The desktop
// app). SQLite has no list columns, so the four list fields below are JSON arrays; the
// read side turns them back into string[] in lib/db/json-list.ts.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VentureType {
  SERVICE
  PRODUCT
  SIDE_GIG
}

enum Province {
  AB
  BC
  MB
  NB
  NL
  NS
  NT
  NU
  ON
  PE
  QC
  SK
  YT
}

/// S2.5.4i: where an idea is on its way to being a business. the ideas DB: every idea is a
/// Venture row from the moment it is named; `stage` says how real it is.
enum VentureStage {
  IDEA
  PROTOTYPE
  FIRST_CUSTOMERS
  ESTABLISHED
}

/// S2.5.4i: how two of the person's ideas relate. Undirected in meaning; stored once (from -> to).
/// maintainer ruling, 2026-09-14: \"some of them will likely intertwine, overlap, and can eventually become
/// sister companies ... they will know what I am working on and be able to cross reference each idea."
enum VentureLinkKind {
  SISTER
  OVERLAPS
  FEEDS
  RELATED
}

enum EmploymentStatus {
  EMPLOYEE
  APPRENTICE
  SELF_EMPLOYED
  BUSINESS_OWNER
  RETIRED
  UNEMPLOYED
  OTHER
}

model User {
  id               String            @id @default(cuid())
  email            String?           @unique
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ventures         Venture[]
  personStatements PersonStatement[]
}

/// What the person told DotAmi about themselves — verbatim, dated, append-only (S2.5.4a).
/// Charter rule: never summarised into a profile; a newer row supersedes by `saidAt`, never by
/// editing an older one. No UPDATE path exists on purpose, and no way to delete one statement. The
/// one DELETE is all of them at once, from the Delete menu on /your-data (lib/privacy/delete.ts; the
/// maintainer's decision, 2026-10-07): wiping every statement isn't editing history. Every statement DotAmi holds is a
/// row here: nothing is read from anywhere else (the `vault` field in the statements API's response
/// is a reserved slot that says no outside source is configured).
model PersonStatement {
  id        String   @id @default(cuid())
  userId    String
  /// The person's own words. Max length enforced at the API (STATEMENT_MAX_CHARS).
  text      String
  /// The calendar day the person says they said it — their claim, not the insert time. Stored
  /// as midnight UTC of that day (lib/person/statements.ts writes it that way).
  saidAt    DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, saidAt])
}

model Venture {
  id               String           @id @default(cuid())
  userId           String
  /// Stable key from TS scenarios (e.g. `example-service`); the cockpit's scenario id.
  scenarioSeedKey  String?          @unique
  name             String
  type             VentureType
  province         Province
  targetRevenueY1  Int
  targetRevenueY3  Int
  structure        String           @default("sole-prop")
  /// S2.5.4d: "user" = the person set the structure; "assumed" = the map's default (sole-prop).
  structureSource  String           @default("assumed")
  hireFirst        Boolean          @default(false)
  /// S2.5.4e: intake Screen A tags + capital toggle, so the cockpit evaluator sees what the person said.
  /// A JSON array of strings.
  activityTags     Json             @default("[]")
  capitalPurchasePlanned Boolean    @default(false)
  employmentStatus EmploymentStatus
  /// S2.5.4i: idea -> prototype -> first customers -> established. Intake's `ventureStage` lands here.
  stage            VentureStage     @default(IDEA)
  /// S2.5.4i: the person's own notes on the idea, in their words. Free text; never summarised by the app.
  notes            String           @default("")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioState    ScenarioState?
  linksFrom        VentureLink[]    @relation("VentureLinkFrom")
  linksTo          VentureLink[]    @relation("VentureLinkTo")
  figures          Figure[]
  expenses         Expense[]

  @@index([userId])
}

/// S2.5.4i: a cross-reference between two ideas. `note` is the person's reason, in their words.
model VentureLink {
  id        String          @id @default(cuid())
  fromId    String
  toId      String
  kind      VentureLinkKind @default(RELATED)
  note      String          @default("")
  createdAt DateTime        @default(now())
  from      Venture         @relation("VentureLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Venture         @relation("VentureLinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
}

model ScenarioState {
  id              String   @id @default(cuid())
  ventureId       String   @unique
  /// JSON arrays of lifecycle node ids.
  activeNodeIds   Json
  completedNodeIds Json
  ghostedNodeIds  Json
  activeBranches  Json
  updatedAt       DateTime @updatedAt
  venture         Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
}

/// [8a] A total about the person's business — confirmed only by the person agreeing to it in the
/// agree prompt ([8b]). Totals, never transactions; the file it came from is never kept.
model Figure {
  id             String    @id @default(cuid())
  ventureId      String
  /// lib/figures/types.ts FIGURE_KINDS — "gross-revenue" for now.
  kind           String
  /// First and last calendar day the total covers, inclusive; stored as midnight UTC of that day.
  periodStart    DateTime
  periodEnd      DateTime
  /// Integer cents, never floating point; negative allowed (a loss). BigInt: Int tops out at $21M.
  amountCents    BigInt
  /// ISO 4217, stored as given — never converted.
  currency       String    @default("CAD")
  /// "typed" | "file" | "agent" | "tax-return"
  sourceKind     String
  /// What the person sees as the source, e.g. "typed by you", "sales-2025.xlsx", "the Lens".
  sourceLabel    String
  /// How many rows were summed, when it came from a file.
  sourceRows     Int?
  /// "proposed" | "confirmed" | "retracted" | "discarded"
  status         String    @default("proposed")
  editedByPerson Boolean   @default(false)
  proposedAt     DateTime  @default(now())
  confirmedAt    DateTime?
  retractedAt    DateTime?
  venture        Venture   @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId, status])
}

/// [8i] One business expense — a single record, not a total: waiting for the person's click, agreed,
/// turned down or taken back, like a Figure's states. Typed by the
/// person now; a spreadsheet, a bank statement or the Lens may propose records later, and each waits
/// for the person's click in the agree prompt, exactly like a Figure. Holds no bank or card number
/// and no receipt yet (a later slice). docs/architecture/expense-records.md § 1;
/// docs/architecture/figures-privacy-review.md.
model Expense {
  id              String    @id @default(cuid())
  ventureId       String
  /// The calendar day of the purchase; stored as midnight UTC of that day, like a Figure's period dates.
  date            DateTime
  /// Whole cents, never floating point. BigInt like Figure.amountCents.
  amountCents     BigInt
  /// ISO 4217, stored as given — never converted.
  currency        String    @default("CAD")
  /// Who it was paid to, in the person's own words ("Staples").
  paidTo          String
  /// What it was for, in the person's own words ("printer paper").
  whatFor         String
  /// Only what the person picked or agreed to; DotAmi never fills one in from the seller's name.
  category        String?
  /// Optional, typed by the person (the CRA lists the seller's address for a record).
  sellerAddress   String?
  /// Optional, typed by the person; lib/expenses/validate.ts says what shape is accepted.
  vendorGstNumber String?
  /// "typed" | "file" | "agent" (lib/expenses/types.ts EXPENSE_SOURCE_KINDS)
  sourceKind      String
  /// What the person sees as the source, e.g. "typed by you", "the Lens".
  sourceLabel     String
  /// "proposed" | "confirmed" | "retracted" | "discarded"
  status          String    @default("proposed")
  editedByPerson  Boolean   @default(false)
  proposedAt      DateTime  @default(now())
  agreedAt        DateTime?
  retractedAt     DateTime?
  venture         Venture   @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId, status])
}

/// [8e] The person's saved choices — DotAmi's first settings table. One row per setting: `key` is a
/// settings-catalog id (lib/settings/catalog.ts), `value` is that setting's JSON text. Which keys
/// exist and what their values may look like is decided in code (lib/settings/values.ts), not here,
/// so a later setting is a new key and never a new column or table.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// [8g] A bank or card account the person allowed DotAmi to read statements from, listed under the
/// person's own name for it ("Business chequing", "Visa ending 1234"; lib/figures/source-account-name.ts
/// says which names are accepted). Never an account or card number, a bank, branch or transit
/// number, a file name, or a hash of any of those: an account number has so few possible values
/// that a hash of it can be reversed by trying them all. Nothing links to this table yet — which
/// figure came from which account waits on a later decision — so taking an account back
/// (`retiredAt`) leaves the figures read from its statements alone. Any later link INTO this table
/// must be hand-written SQL with a test that seeded data survives (the desktop migrator runs with
/// foreign keys on).
model SourceAccount {
  id        String    @id @default(cuid())
  /// The person's own name for the account, as they typed it (trimmed).
  name      String
  /// "once" | "always" | "every" (ACCOUNT_ALLOWANCES in lib/figures/source-account-name.ts): which button
  /// the person pressed on the warning ("every": added while "Always allow every account" was on).
  /// "once" shows the warning again before the next statement.
  allowance String
  /// When the person last agreed to the warning for this account.
  agreedAt  DateTime
  /// When the person took it back in Settings; null while it is in use. The row stays (its name
  /// and dates) until Delete removes every account.
  retiredAt DateTime?
  createdAt DateTime  @default(now())
}
